{
  "name": "rbx-agents",
  "version": "0.2.1",
  "description": "A local-first desktop workspace for AI agents that build Roblox experiences.",
  "main": "out/main/index.js",
  "author": "MrHB102",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/setup-electron.mjs",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "test:package": "node scripts/smoke-package.mjs",
    "dist": "npm run build && electron-builder --publish never",
    "dist:win": "npm run build && electron-builder --win --x64 --arm64 --publish never",
    "dist:linux": "npm run build && electron-builder --linux --x64 --arm64 --publish never",
    "dist:legacy:win": "npm run build && electron-builder --win --ia32 --config.electronVersion=43.8.3 --publish never",
    "dist:legacy:linux": "npm run build && electron-builder --linux tar.gz --armv7l --config.electronVersion=43.8.3 --publish never",
    "verify:skills": "node scripts/verify-skills.mjs"
  },
  "dependencies": {
    "@chrrxs/robloxstudio-mcp": "3.3.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "jose": "^6.1.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "typescript": "^6.0.0",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  }
}
